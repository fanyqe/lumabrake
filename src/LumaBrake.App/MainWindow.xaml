                                            <TextBlock x:Name="NightColorStatusText" Text="Night color off" Style="{StaticResource MutedText}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Style="{StaticResource PanelCard}">
                                        <StackPanel>
                                            <TextBlock Text="Rhythm" Style="{StaticResource MetricLabel}" />
                                            <Grid Margin="0,14,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="14" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="14" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Mode" Style="{StaticResource MetricLabel}" />
