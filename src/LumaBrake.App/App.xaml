<Application x:Class="LumaBrake.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="PageBrush" Color="#05080D" />
        <SolidColorBrush x:Key="PanelBrush" Color="#0E131B" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#121923" />
        <SolidColorBrush x:Key="SurfaceAltBrush" Color="#182234" />
        <SolidColorBrush x:Key="RuleBrush" Color="#283244" />
        <SolidColorBrush x:Key="InkBrush" Color="#F4F8FF" />
        <SolidColorBrush x:Key="MutedBrush" Color="#95A2B7" />
        <SolidColorBrush x:Key="AccentBrush" Color="#4A8DFF" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#73A7FF" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#162B52" />
        <SolidColorBrush x:Key="WarningBrush" Color="#F0AE4E" />
        <SolidColorBrush x:Key="WarningSoftBrush" Color="#332414" />
        <SolidColorBrush x:Key="DangerBrush" Color="#FF6B73" />
        <SolidColorBrush x:Key="DangerSoftBrush" Color="#35181D" />
        <SolidColorBrush x:Key="FocusRingBrush" Color="#8BB6FF" />
    </Application.Resources>
</Application>
