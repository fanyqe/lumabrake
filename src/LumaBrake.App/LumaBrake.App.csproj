<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\LumaBrake.Core\LumaBrake.Core.csproj" />
    <ProjectReference Include="..\LumaBrake.Domain\LumaBrake.Domain.csproj" />
    <ProjectReference Include="..\LumaBrake.MonitorControl\LumaBrake.MonitorControl.csproj" />
    <ProjectReference Include="..\LumaBrake.Persistence\LumaBrake.Persistence.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\LumaBrake.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\LumaBrake.ico" />
    <None Remove="Assets\LumaBrakeLogo.png" />
    <None Remove="Assets\LumaBrakeTray.ico" />
    <None Remove="Assets\LumaBrakeTray.png" />
    <Resource Include="Assets\LumaBrake.ico" />
    <Resource Include="Assets\LumaBrakeLogo.png" />
    <Resource Include="Assets\LumaBrakeTray.ico" />
    <Resource Include="Assets\LumaBrakeTray.png" />
  </ItemGroup>

</Project>
