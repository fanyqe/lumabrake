<Project Sdk="WixToolset.Sdk/6.0.2">

  <PropertyGroup>
    <OutputType>Package</OutputType>
    <OutputName>LumaBrake-$(RuntimeIdentifier)-setup</OutputName>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <InstallerPlatform>x64</InstallerPlatform>
    <ProductVersion Condition="'$(ProductVersion)' == ''">0.1.0</ProductVersion>
    <PayloadDir Condition="'$(PayloadDir)' == ''">$(MSBuildProjectDirectory)\..\..\artifacts\portable\LumaBrake-$(RuntimeIdentifier)</PayloadDir>
    <DefineConstants>ProductVersion=$(ProductVersion);PayloadDir=$(PayloadDir);RuntimeIdentifier=$(RuntimeIdentifier)</DefineConstants>
    <SuppressIces>ICE38;ICE64;ICE91</SuppressIces>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="6.0.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <BindVariable Include="WixUILicenseRtf=$(MSBuildProjectDirectory)\License.rtf" />
  </ItemGroup>

</Project>
