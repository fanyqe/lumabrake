                                                <StackPanel Margin="0,0,12,0">
                                                    <TextBlock Text="Overlay" Style="{StaticResource MetricLabel}" />
                                                    <TextBlock x:Name="OpacityText" Text="0%" Style="{StaticResource MetricValue}" />
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="Events" Style="{StaticResource MetricLabel}" />
                                                    <TextBlock x:Name="EventsText" Text="0" Style="{StaticResource MetricValue}" />
                                                </StackPanel>
                                            </UniformGrid>
                                        </Grid>
                                    </Border>

