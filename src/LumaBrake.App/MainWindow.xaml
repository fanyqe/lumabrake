                                                    <Border Width="54" Height="54" CornerRadius="27" Background="{StaticResource SuccessSoftBrush}" BorderBrush="#397B49" BorderThickness="1">
                                                        <TextBlock Text="&#xE9CA;" Style="{StaticResource IconGlyph}" Foreground="{StaticResource SuccessBrush}" />
                                                    </Border>
                                                    <TextBlock Text="Sensor" Style="{StaticResource MutedText}" Margin="0,8,0,0" HorizontalAlignment="Center" />
                                                </StackPanel>
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Border Width="54" Height="54" CornerRadius="27" Background="{StaticResource SuccessSoftBrush}" BorderBrush="#397B49" BorderThickness="1">
                                                        <TextBlock Text="&#xE950;" Style="{StaticResource IconGlyph}" Foreground="{StaticResource SuccessBrush}" />
                                                    </Border>
                                                    <TextBlock Text="Analysis" Style="{StaticResource MutedText}" Margin="0,8,0,0" HorizontalAlignment="Center" />
                                                </StackPanel>
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Border Width="54" Height="54" CornerRadius="27" Background="{StaticResource SuccessSoftBrush}" BorderBrush="#397B49" BorderThickness="1">
                                                        <TextBlock Text="&#xE73E;" Style="{StaticResource IconGlyph}" Foreground="{StaticResource SuccessBrush}" />
                                                    </Border>
                                                    <TextBlock Text="Dimming" Style="{StaticResource MutedText}" Margin="0,8,0,0" HorizontalAlignment="Center" />
                                                </StackPanel>
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Border Width="54" Height="54" CornerRadius="27" Background="{StaticResource ActiveNavBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                                                        <TextBlock Text="&#xE7F4;" Style="{StaticResource IconGlyph}" Foreground="{StaticResource AccentHoverBrush}" />
                                                    </Border>
                                                    <TextBlock Text="Monitor" Style="{StaticResource MutedText}" Margin="0,8,0,0" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="2" Style="{StaticResource PanelCard}">
                                        <StackPanel>
                                            <TextBlock Text="Windows Startup" Style="{StaticResource MetricLabel}" />
                                            <TextBlock x:Name="StartupStatusText" Text="Checking startup status" TextWrapping="Wrap" Margin="0,8,0,0" />
                                            <UniformGrid Columns="2" Margin="0,14,0,0">
                                                <Button x:Name="EnableStartupButton" Content="Enable" Click="EnableStartupButton_OnClick" Margin="0,0,8,0" Style="{StaticResource SoftButton}" />
                                                <Button x:Name="DisableStartupButton" Content="Disable" Click="DisableStartupButton_OnClick" Style="{StaticResource WarningButton}" />
                                            </UniformGrid>
                                            <Separator Margin="0,22,0,18" Background="{StaticResource RuleBrush}" />
                                            <TextBlock Text="Runtime status" Style="{StaticResource MetricLabel}" />
                                            <TextBlock x:Name="HotkeyText" Text="Ready." TextWrapping="Wrap" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource PanelCard}">
                                        <StackPanel>
                                            <TextBlock Text="Recent Logs" Style="{StaticResource MetricLabel}" />
                                            <Border Background="{StaticResource PanelDeepBrush}" BorderBrush="{StaticResource RuleBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,14,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="[INFO] Engine running" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                                                    <TextBlock Text="[INFO] Monitors calibrated" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0" />
                                                    <TextBlock Text="[INFO] Dimming target stable" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Settings">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <Grid Margin="22">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
