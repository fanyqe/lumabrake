<Window x:Class="LumaBrake.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LumaBrake" Height="520" Width="860"
        MinHeight="460" MinWidth="720"
        Background="{StaticResource PageBrush}">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="MinWidth" Value="132" />
            <Setter Property="Foreground" Value="#0B1413" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="LumaBrake" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="Real-time brightness spike reduction for Windows." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />
            </StackPanel>
            <Border DockPanel.Dock="Right" BorderBrush="{StaticResource RuleBrush}" BorderThickness="1" CornerRadius="8" Padding="14,9" Background="{StaticResource PanelBrush}">
                <TextBlock x:Name="StateText" Text="Starting" FontWeight="SemiBold" />
            </Border>
        </DockPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource RuleBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Live Monitor" FontSize="18" FontWeight="SemiBold" />

                    <UniformGrid Grid.Row="2" Columns="2" Rows="2">
                        <StackPanel Margin="0,0,16,16">
                            <TextBlock Text="Average luminance" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock x:Name="AverageText" Text="0.000" FontSize="26" FontWeight="SemiBold" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="95th percentile" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock x:Name="P95Text" Text="0.000" FontSize="26" FontWeight="SemiBold" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Overlay opacity" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock x:Name="OpacityText" Text="0%" FontSize="26" FontWeight="SemiBold" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Protection events" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock x:Name="EventsText" Text="0" FontSize="26" FontWeight="SemiBold" Margin="0,6,0,0" />
                        </StackPanel>
                    </UniformGrid>

                    <StackPanel Grid.Row="4">
                        <TextBlock Text="Manual dimming" Foreground="{StaticResource MutedBrush}" />
                        <Slider x:Name="ManualDimmingSlider" Minimum="0" Maximum="0.90" TickFrequency="0.02" ValueChanged="ManualDimmingSlider_OnValueChanged" Margin="0,8,0,0" />
                        <TextBlock x:Name="ManualDimmingText" Text="0%" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" />
                        <Separator Margin="0,12,0,12" Background="{StaticResource RuleBrush}" />
                        <TextBlock Text="Maximum dimming" Foreground="{StaticResource MutedBrush}" />
                        <Slider x:Name="MaximumOpacitySlider" Minimum="0.10" Maximum="0.92" TickFrequency="0.02" ValueChanged="MaximumOpacitySlider_OnValueChanged" Margin="0,8,0,0" />
                        <TextBlock x:Name="MaximumOpacityText" Text="64%" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>

                    <TextBlock Grid.Row="6" x:Name="HotkeyText" Text="Emergency hotkey: Ctrl+Alt+Shift+L" Foreground="{StaticResource MutedBrush}" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource RuleBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel>
                    <TextBlock Text="Controls" FontSize="18" FontWeight="SemiBold" />
                    <Button x:Name="ToggleButton" Content="Disable" Click="ToggleButton_OnClick" Margin="0,20,0,0" />
                    <Button Content="Emergency disable" Click="EmergencyButton_OnClick" Margin="0,10,0,0" Background="#F6B47E" BorderBrush="#F6B47E" />
                    <Button Content="Save settings" Click="SaveButton_OnClick" Margin="0,10,0,0" Background="#D7E4DF" BorderBrush="#D7E4DF" />
                    <Separator Margin="0,22,0,18" Background="{StaticResource RuleBrush}" />
                    <TextBlock Text="Capture path" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock x:Name="MonitorText" Text="Detecting monitors" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <Button Content="Refresh monitors" Click="RefreshMonitorsButton_OnClick" Margin="0,14,0,0" Background="#D7E4DF" BorderBrush="#D7E4DF" />
                    <TextBlock Text="Raw frames are discarded after analysis." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" x:Name="FooterText" Text="Core processing is local and deterministic. Protected content and exclusive full-screen modes may limit capture." Foreground="{StaticResource MutedBrush}" Margin="0,22,0,0" />
    </Grid>
</Window>
