                                                    <TextBlock x:Name="NightColorProgressText" Grid.Row="2" Grid.ColumnSpan="2" Text="0% active" Foreground="{StaticResource InkBrush}" FontSize="11" HorizontalAlignment="Right" Margin="0,18,0,0" />
                                                </Grid>
