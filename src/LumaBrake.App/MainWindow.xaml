                                                        <ComboBoxItem Content="Automatic" />
                                                        <ComboBoxItem Content="Always comfort" />
                                                        <ComboBoxItem Content="Sunrise by city" />
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="City" Style="{StaticResource MetricLabel}" />
                                                    <TextBox x:Name="NightColorLocationTextBox" Text="Istanbul" LostFocus="NightColorTextBox_OnLostFocus" KeyDown="NightColorTextBox_OnKeyDown" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="4">
                                                    <TextBlock Text="Comfort" Style="{StaticResource MetricLabel}" />
                                                    <ComboBox x:Name="NightColorComfortComboBox" SelectionChanged="NightColorControl_OnSelectionChanged">
                                                        <ComboBoxItem Content="Gentle" />
                                                        <ComboBoxItem Content="Balanced" />
                                                        <ComboBoxItem Content="Deep" />
                                                    </ComboBox>
                                                </StackPanel>
                                            </Grid>

                                            <Grid Margin="0,18,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="14" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="14" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Wake time" Style="{StaticResource MetricLabel}" />
                                                    <TextBox x:Name="NightColorCustomEndTextBox" Text="07:00" HorizontalContentAlignment="Right" LostFocus="NightColorTextBox_OnLostFocus" KeyDown="NightColorTextBox_OnKeyDown" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Sleep time" Style="{StaticResource MetricLabel}" />
                                                    <TextBox x:Name="NightColorCustomStartTextBox" Text="22:30" HorizontalContentAlignment="Right" LostFocus="NightColorTextBox_OnLostFocus" KeyDown="NightColorTextBox_OnKeyDown" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="4">
                                                    <TextBlock Text="Fade" Style="{StaticResource MetricLabel}" />
                                                    <Slider x:Name="NightColorTransitionDurationSlider" Minimum="45" Maximum="360" TickFrequency="5" ValueChanged="NightColorTransitionDurationSlider_OnValueChanged" />
                                                    <TextBox x:Name="NightColorTransitionDurationTextBox" Text="60 min" HorizontalContentAlignment="Right" LostFocus="NightColorTextBox_OnLostFocus" KeyDown="NightColorTextBox_OnKeyDown" />
                                                </StackPanel>
                                            </Grid>

                                            <Border Margin="0,18,0,0" Background="{StaticResource PanelDeepBrush}" BorderBrush="{StaticResource RuleBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="0.8*" />
                                                            <ColumnDefinition Width="0.8*" />
                                                            <ColumnDefinition Width="1.4*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="Sunrise" Style="{StaticResource MetricLabel}" />
                                                            <TextBlock x:Name="NightColorSunriseText" Text="--:--" Style="{StaticResource MetricValue}" FontSize="18" Foreground="{StaticResource AccentHoverBrush}" />
