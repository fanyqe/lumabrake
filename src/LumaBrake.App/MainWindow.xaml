                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="Sunset" Style="{StaticResource MetricLabel}" />
                                                            <TextBlock x:Name="NightColorSunsetText" Text="--:--" Style="{StaticResource MetricValue}" FontSize="18" Foreground="{StaticResource AmberBrush}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="Next change" Style="{StaticResource MetricLabel}" />
                                                            <TextBlock x:Name="NightColorNextChangeText"
                                                                       Text="--"
                                                                       Style="{StaticResource MetricValue}"
                                                                       FontSize="16"
                                                                       TextWrapping="Wrap"
                                                                       LineHeight="20" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <Grid Margin="0,16,0,0">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="34" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid x:Name="NightColorPreviewTimeline" Height="34">
                                                            <Border x:Name="NightColorPreviewSwatch" CornerRadius="8" BorderBrush="{StaticResource RuleBrush}" BorderThickness="1">
                                                                <Border.Background>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                        <GradientStop Color="#1A2144" Offset="0" />
                                                                        <GradientStop Color="#F2C46D" Offset="0.30" />
                                                                        <GradientStop Color="#AFC9FF" Offset="0.52" />
                                                                        <GradientStop Color="#E29348" Offset="0.73" />
                                                                        <GradientStop Color="#201229" Offset="1" />
                                                                    </LinearGradientBrush>
                                                                </Border.Background>
                                                            </Border>
                                                            <Border x:Name="NightColorPreviewGlow"
                                                                    Width="0"
                                                                    HorizontalAlignment="Left"
                                                                    CornerRadius="8"
                                                                    Opacity="0.38"
                                                                    IsHitTestVisible="False">
                                                                <Border.Background>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                        <GradientStop Color="#10FFFFFF" Offset="0" />
                                                                        <GradientStop Color="#55E9A640" Offset="0.74" />
                                                                        <GradientStop Color="#20FFFFFF" Offset="1" />
                                                                    </LinearGradientBrush>
                                                                </Border.Background>
                                                            </Border>
                                                            <Canvas ClipToBounds="False" IsHitTestVisible="False">
                                                                <Border x:Name="NightColorNowMarker"
                                                                        Canvas.Left="0"
                                                                        Width="2"
                                                                        Height="40"
                                                                        Margin="0,-3,0,0"
                                                                        CornerRadius="1"
                                                                        Background="{StaticResource InkBrush}"
                                                                        Opacity="0.70" />
                                                                <Border x:Name="NightColorPreviewMarker"
                                                                        Canvas.Left="0"
                                                                        Width="8"
                                                                        Height="42"
                                                                        Margin="-4,-4,0,0"
                                                                        CornerRadius="4"
                                                                        Background="{StaticResource AmberBrush}"
                                                                        BorderBrush="{StaticResource InkBrush}"
                                                                        BorderThickness="1"
                                                                        Opacity="0.85">
                                                                    <Border.Effect>
                                                                        <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.55" Color="#E9A640" />
                                                                    </Border.Effect>
                                                                    <Border.Triggers>
                                                                        <EventTrigger RoutedEvent="Loaded">
                                                                            <BeginStoryboard>
                                                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.68" To="1" Duration="0:0:0.9" />
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </EventTrigger>
                                                                    </Border.Triggers>
                                                                </Border>
                                                            </Canvas>
                                                        </Grid>
                                                        <Grid Grid.Row="1" Margin="2,7,2,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="00:00" Style="{StaticResource MutedText}" />
                                                            <TextBlock Grid.Column="1" Text="12:00" Style="{StaticResource MutedText}" HorizontalAlignment="Center" />
                                                            <TextBlock Grid.Column="2" Text="24:00" Style="{StaticResource MutedText}" HorizontalAlignment="Right" />
                                                        </Grid>
                                                        <UniformGrid Grid.Row="2" Columns="3" Margin="0,14,0,0">
                                                            <StackPanel Margin="0,0,12,0">
                                                                <TextBlock Text="Now" Style="{StaticResource MetricLabel}" />
                                                                <TextBlock x:Name="NightColorNowText" Text="--:--" Style="{StaticResource MetricValue}" FontSize="16" />
                                                            </StackPanel>
                                                            <StackPanel Margin="0,0,12,0">
                                                                <TextBlock Text="Preview" Style="{StaticResource MetricLabel}" />
                                                                <TextBlock x:Name="NightColorPreviewClockText" Text="Ready" Style="{StaticResource MetricValue}" FontSize="16" />
                                                            </StackPanel>
                                                            <StackPanel>
                                                                <TextBlock Text="Color" Style="{StaticResource MetricLabel}" />
                                                                <TextBlock x:Name="NightColorPreviewKelvinText" Text="6500K" Style="{StaticResource MetricValue}" FontSize="16" />
                                                            </StackPanel>
                                                        </UniformGrid>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <StackPanel Visibility="Collapsed">
                                                <Slider x:Name="NightColorTemperatureSlider" Minimum="1000" Maximum="12000" TickFrequency="100" ValueChanged="NightColorTemperatureSlider_OnValueChanged" />
                                                <TextBox x:Name="NightColorTemperatureTextBox" Text="4200K" />
                                                <Slider x:Name="NightColorDayTemperatureSlider" Minimum="1000" Maximum="12000" TickFrequency="100" ValueChanged="NightColorDayTemperatureSlider_OnValueChanged" />
                                                <TextBox x:Name="NightColorDayTemperatureTextBox" Text="6500K" />
                                                <Slider x:Name="NightColorNightTemperatureSlider" Minimum="1000" Maximum="12000" TickFrequency="100" ValueChanged="NightColorNightTemperatureSlider_OnValueChanged" />
                                                <TextBox x:Name="NightColorNightTemperatureTextBox" Text="3400K" />
                                                <Slider x:Name="NightColorBrightnessSlider" Minimum="0.20" Maximum="1.00" TickFrequency="0.05" ValueChanged="NightColorBrightnessSlider_OnValueChanged" />
                                                <TextBox x:Name="NightColorBrightnessTextBox" Text="100%" />
                                                <Slider x:Name="NightColorTintStrengthSlider" Minimum="0" Maximum="1.00" TickFrequency="0.05" ValueChanged="NightColorTintStrengthSlider_OnValueChanged" />
                                                <TextBox x:Name="NightColorTintStrengthTextBox" Text="100%" />
                                                <TextBox x:Name="NightColorLatitudeTextBox" />
                                                <TextBox x:Name="NightColorLongitudeTextBox" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="4" Style="{StaticResource PanelCard}">
                                        <StackPanel>
                                            <TextBlock Text="Transition" Style="{StaticResource MetricLabel}" />
                                            <ComboBox x:Name="NightColorTransitionComboBox" SelectionChanged="NightColorControl_OnSelectionChanged">
                                                <ComboBoxItem Content="Smooth" />
                                                <ComboBoxItem Content="Instant" />
                                            </ComboBox>
                                            <Button x:Name="NightColorPreviewButton" Click="PreviewNightColorButton_OnClick" Margin="0,14,0,0">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock x:Name="NightColorPreviewButtonIcon" Text="&#xE768;" Style="{StaticResource IconGlyph}" FontSize="14" Foreground="{StaticResource InkBrush}" Margin="0,0,8,0" />
                                                    <TextBlock x:Name="NightColorPreviewButtonText" Text="Preview day" Foreground="{StaticResource InkBrush}" />
                                                </StackPanel>
                                            </Button>
                                            <CheckBox x:Name="NightColorPauseFullScreenCheckBox" Content="Pause in full-screen apps" Checked="NightColorControl_OnChanged" Unchecked="NightColorControl_OnChanged" Margin="0,18,0,0" />
                                            <Border x:Name="NightColorPauseStateCard" Style="{StaticResource SoftCard}" Margin="0,14,0,0" Padding="12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="34" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border x:Name="NightColorPauseStateBadge" Width="28" Height="28" CornerRadius="14" Background="{StaticResource ActiveNavBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                                                        <TextBlock x:Name="NightColorPauseStateIcon" Text="&#xE708;" Style="{StaticResource IconGlyph}" FontSize="14" Foreground="{StaticResource AccentHoverBrush}" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock x:Name="NightColorPauseStateText" Text="Ready" Foreground="{StaticResource InkBrush}" FontWeight="SemiBold" />
                                                        <TextBlock x:Name="NightColorPauseStateDetailText" Text="Automatic schedule" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <Button x:Name="PauseNightColorButton" Click="PauseNightColorButton_OnClick" Margin="0,10,0,0" Style="{StaticResource SoftButton}">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock x:Name="PauseNightColorButtonIcon" Text="&#xE769;" Style="{StaticResource IconGlyph}" FontSize="14" Foreground="{StaticResource AccentHoverBrush}" Margin="0,0,8,0" />
                                                    <TextBlock x:Name="PauseNightColorButtonText" Text="Pause 1 hour" Foreground="{StaticResource InkBrush}" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="ResumeNightColorButton" Click="ResumeNightColorButton_OnClick" Margin="0,10,0,0" Style="{StaticResource SoftButton}" Visibility="Collapsed">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock x:Name="ResumeNightColorButtonIcon" Text="&#xE768;" Style="{StaticResource IconGlyph}" FontSize="14" Foreground="{StaticResource SuccessBrush}" Margin="0,0,8,0" />
                                                    <TextBlock x:Name="ResumeNightColorButtonText" Text="Resume now" Foreground="{StaticResource InkBrush}" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Rules">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <Grid Margin="22">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="360" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="16" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Border Style="{StaticResource PanelCard}">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Rule Routing" Style="{StaticResource MetricLabel}" />
                                                    <TextBlock Text="App focus rules decide what should pause, stay warm, or keep normal protection." Style="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Border Grid.Column="1" Style="{StaticResource PillCard}" Padding="9,5">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse x:Name="RuleStatusDot" Width="7" Height="7" Fill="{StaticResource SuccessBrush}" Margin="0,0,7,0" />
                                                        <TextBlock x:Name="RuleStatusText" Text="Rules enabled" Style="{StaticResource MutedText}" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <UniformGrid Columns="4" Margin="0,22,0,0">
                                                <StackPanel HorizontalAlignment="Center" Margin="0,0,12,0">
                                                    <Border Width="56" Height="56" CornerRadius="28" Background="{StaticResource ActiveNavBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                                                        <TextBlock Text="&#xE950;" Style="{StaticResource IconGlyph}" FontSize="22" Foreground="{StaticResource AccentHoverBrush}" />
                                                    </Border>
                                                    <TextBlock Text="Detect app" Style="{StaticResource MutedText}" Margin="0,9,0,0" HorizontalAlignment="Center" />
                                                </StackPanel>
                                                <StackPanel HorizontalAlignment="Center" Margin="0,0,12,0">
                                                    <Border Width="56" Height="56" CornerRadius="28" Background="{StaticResource AmberSoftBrush}" BorderBrush="{StaticResource AmberBrush}" BorderThickness="1">
                                                        <TextBlock Text="&#xE8FD;" Style="{StaticResource IconGlyph}" FontSize="22" Foreground="{StaticResource AmberBrush}" />
                                                    </Border>
                                                    <TextBlock Text="Match rule" Style="{StaticResource MutedText}" Margin="0,9,0,0" HorizontalAlignment="Center" />
                                                </StackPanel>
                                                <StackPanel HorizontalAlignment="Center" Margin="0,0,12,0">
                                                    <Border Width="56" Height="56" CornerRadius="28" Background="{StaticResource SuccessSoftBrush}" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1">
                                                        <TextBlock Text="&#xE73E;" Style="{StaticResource IconGlyph}" FontSize="22" Foreground="{StaticResource SuccessBrush}" />
                                                    </Border>
                                                    <TextBlock Text="Apply profile" Style="{StaticResource MutedText}" Margin="0,9,0,0" HorizontalAlignment="Center" />
                                                </StackPanel>
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Border Width="56" Height="56" CornerRadius="28" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource RuleBrush}" BorderThickness="1">
                                                        <TextBlock Text="&#xE74E;" Style="{StaticResource IconGlyph}" FontSize="22" Foreground="{StaticResource MutedBrush}" />
                                                    </Border>
                                                    <TextBlock Text="Keep saved" Style="{StaticResource MutedText}" Margin="0,9,0,0" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </UniformGrid>

                                            <UniformGrid Columns="3" Margin="0,24,0,0">
                                                <Border Style="{StaticResource SoftCard}" Margin="0,0,12,0">
                                                    <StackPanel>
                                                        <TextBlock Text="Rules" Style="{StaticResource MetricLabel}" />
                                                        <TextBlock x:Name="RuleCountText" Text="0" Style="{StaticResource MetricValue}" FontSize="22" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Style="{StaticResource SoftCard}" Margin="0,0,12,0">
                                                    <StackPanel>
                                                        <TextBlock Text="Night Color" Style="{StaticResource MetricLabel}" />
                                                        <TextBlock x:Name="RuleNightColorText" Text="No pauses" Style="{StaticResource MetricValue}" FontSize="16" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Style="{StaticResource SoftCard}">
                                                    <StackPanel>
                                                        <TextBlock Text="Selected" Style="{StaticResource MetricLabel}" />
                                                        <TextBlock x:Name="RuleSelectedText" Text="None" Style="{StaticResource MetricValue}" FontSize="16" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Style="{StaticResource PanelCard}">
                                        <StackPanel>
                                            <TextBlock Text="Profiles" Style="{StaticResource MetricLabel}" />
                                            <TextBlock Text="Saved profile" Style="{StaticResource MutedText}" Margin="0,14,0,0" />
                                            <ComboBox x:Name="ProfileComboBox" SelectionChanged="ProfileComboBox_OnSelectionChanged" />
                                            <Grid Margin="0,14,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Profile ID" Style="{StaticResource MetricLabel}" />
                                                    <TextBox x:Name="ProfileIdTextBox" TextChanged="ProfileTextBox_OnTextChanged" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Profile name" Style="{StaticResource MetricLabel}" />
                                                    <TextBox x:Name="ProfileNameTextBox" />
                                                </StackPanel>
                                            </Grid>
                                            <UniformGrid Columns="3" Margin="0,14,0,0">
                                                <Button Content="Save" Click="SaveProfileButton_OnClick" Margin="0,0,8,0" Style="{StaticResource SoftButton}" />
                                                <Button x:Name="ApplyProfileButton" Content="Apply" Click="ApplyProfileButton_OnClick" Margin="0,0,8,0" Style="{StaticResource SoftButton}" />
                                                <Button x:Name="RemoveProfileButton" Content="Remove" Click="RemoveProfileButton_OnClick" Style="{StaticResource WarningButton}" />
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource PanelCard}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="260" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Application Rules" Style="{StaticResource MetricLabel}" />
                                                <CheckBox x:Name="ApplicationRulesCheckBox" Content="Application rules" Checked="ApplicationRulesCheckBox_OnChanged" Unchecked="ApplicationRulesCheckBox_OnChanged" Margin="0,14,0,12" />
                                                <TextBlock Text="Saved rule" Style="{StaticResource MutedText}" />
                                                <ComboBox x:Name="ApplicationRuleComboBox" SelectionChanged="ApplicationRuleComboBox_OnSelectionChanged" />
                                            </StackPanel>
                                            <Grid Grid.Column="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Rule ID" Style="{StaticResource MetricLabel}" />
                                                    <TextBox x:Name="ApplicationRuleIdTextBox" TextChanged="ApplicationRuleEditor_OnChanged" />
                                                    <TextBlock Text="Process" Style="{StaticResource MetricLabel}" Margin="0,14,0,0" />
                                                    <TextBox x:Name="ApplicationRuleProcessTextBox" TextChanged="ApplicationRuleEditor_OnChanged" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Rule name" Style="{StaticResource MetricLabel}" />
                                                    <TextBox x:Name="ApplicationRuleNameTextBox" TextChanged="ApplicationRuleEditor_OnChanged" />
                                                    <TextBlock Text="Window title contains" Style="{StaticResource MetricLabel}" Margin="0,14,0,0" />
                                                    <TextBox x:Name="ApplicationRuleTitleTextBox" TextChanged="ApplicationRuleEditor_OnChanged" />
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel Grid.Column="4">
                                                <CheckBox x:Name="ApplicationRuleEnabledCheckBox" Content="Rule enabled" Checked="ApplicationRuleEditor_OnChanged" Unchecked="ApplicationRuleEditor_OnChanged" />
                                                <CheckBox x:Name="ApplicationRuleNightColorCheckBox" Content="Pause Night Color for this app" Checked="ApplicationRuleEditor_OnChanged" Unchecked="ApplicationRuleEditor_OnChanged" />
                                                <Button x:Name="SaveApplicationRuleButton" Content="Save rule" Click="SaveApplicationRuleButton_OnClick" Margin="0,10,0,0" Style="{StaticResource SoftButton}" />
                                                <Button x:Name="RemoveApplicationRuleButton" Content="Remove" Click="RemoveApplicationRuleButton_OnClick" Margin="0,10,0,0" Style="{StaticResource WarningButton}" />
                                                <Button x:Name="ClearApplicationRulesButton" Content="Clear" Click="ClearApplicationRulesButton_OnClick" Margin="0,10,0,0" Style="{StaticResource WarningButton}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Diagnostics">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <Grid Margin="22">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="16" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Border Style="{StaticResource PanelCard}">
                                        <StackPanel>
                                            <TextBlock Text="Performance" Style="{StaticResource MetricLabel}" />
                                            <UniformGrid Columns="2" Margin="0,14,0,0">
                                                <StackPanel Margin="0,0,12,0">
                                                    <TextBlock Text="Frame time" Style="{StaticResource MutedText}" />
                                                    <TextBlock Text="2.1 ms" Style="{StaticResource MetricValue}" FontSize="20" Foreground="{StaticResource AccentHoverBrush}" />
