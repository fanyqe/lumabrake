                                                        <ComboBoxItem Content="Comfort" />
                                                        <ComboBoxItem Content="Balanced" />
                                                        <ComboBoxItem Content="Strong" />
                                                        <ComboBoxItem Content="Maximum" />
                                                        <ComboBoxItem Content="OLED Care" />
                                                        <ComboBoxItem Content="Custom" />
                                                    </ComboBox>
                                                    <TextBlock x:Name="OverviewProtectionPresetDetailText" Text="Everyday balance" Style="{StaticResource MutedText}" Margin="0,5,0,0" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Border Style="{StaticResource PanelCard}">
                                            <StackPanel>
                                                <TextBlock Text="System Status" Style="{StaticResource MetricLabel}" />
                                                <Grid Margin="0,12,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Engine" />
                                                    <TextBlock Grid.Column="1" Text="Running" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" />
                                                </Grid>
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Monitors" />
                                                    <TextBlock Grid.Column="1" Text="Active" Foreground="{StaticResource AccentHoverBrush}" />
                                                </Grid>
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Local masks" />
                                                    <TextBlock Grid.Column="1" x:Name="RegionalMasksText" Text="0" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <Border Grid.Row="2" Style="{StaticResource PanelCard}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="128" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Brightness Over Time" Style="{StaticResource MetricLabel}" />
                                            <Border Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource PillCard}" Padding="9,5">
                                                <TextBlock x:Name="BrightnessChartWindowText" Text="Live" Style="{StaticResource MutedText}" />
                                            </Border>

                                            <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,16,0,0" MinHeight="230">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <Border BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,1,0,0" />
                                                <Border Grid.Row="1" BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,1,0,0" Opacity="0.7" />
                                                <Border Grid.Row="2" BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,1,0,1" Opacity="0.7" />
                                                <Canvas x:Name="BrightnessHistoryCanvas"
                                                        Margin="10,8,12,16"
                                                        ClipToBounds="True"
                                                        SizeChanged="BrightnessHistoryCanvas_OnSizeChanged">
                                                    <Polyline x:Name="P95BrightnessLine"
                                                              Stroke="{StaticResource AmberBrush}"
                                                              StrokeThickness="1.5"
                                                              StrokeLineJoin="Round"
                                                              Opacity="0.86" />
                                                    <Polyline x:Name="ActualBrightnessLine"
                                                              Stroke="{StaticResource AccentBrush}"
                                                              StrokeThickness="2"
                                                              StrokeLineJoin="Round" />
                                                    <Polyline x:Name="OverlayOpacityLine"
                                                              Stroke="{StaticResource SuccessBrush}"
                                                              StrokeThickness="1.5"
                                                              StrokeLineJoin="Round"
                                                              StrokeDashArray="3 4"
                                                              Opacity="0.78" />
                                                </Canvas>
                                                <TextBlock x:Name="BrightnessChartEmptyText"
                                                           Text="Collecting live samples"
                                                           Style="{StaticResource MutedText}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Top"
                                                            Margin="0,10,14,0">
                                                    <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" Margin="0,0,6,0" />
                                                    <TextBlock Text="Actual" Style="{StaticResource MutedText}" Margin="0,0,14,0" />
                                                    <Ellipse Width="7" Height="7" Fill="{StaticResource AmberBrush}" Margin="0,0,6,0" />
                                                    <TextBlock Text="95th" Style="{StaticResource MutedText}" Margin="0,0,14,0" />
                                                    <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" Margin="0,0,6,0" />
                                                    <TextBlock Text="Overlay" Style="{StaticResource MutedText}" />
                                                </StackPanel>
                                            </Grid>

                                            <UniformGrid Grid.Row="2" Grid.ColumnSpan="2" Columns="4" Margin="0,14,0,0">
                                                <StackPanel Margin="0,0,12,0">
                                                    <TextBlock Text="Actual" Style="{StaticResource MetricLabel}" />
                                                    <TextBlock x:Name="AverageText" Text="0.000" Style="{StaticResource MetricValue}" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,12,0">
                                                    <TextBlock Text="95th" Style="{StaticResource MetricLabel}" />
                                                    <TextBlock x:Name="P95Text" Text="0.000" Style="{StaticResource MetricValue}" />
