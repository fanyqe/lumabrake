                                                <Border Grid.Column="1" Style="{StaticResource PillCard}" Padding="9,5" VerticalAlignment="Top">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" Margin="0,0,6,0" />
                                                        <TextBlock Text="Local" Style="{StaticResource MutedText}" />
