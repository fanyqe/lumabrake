                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <TextBlock Text="&#xE708;" Style="{StaticResource IconGlyph}" FontSize="14" Foreground="{StaticResource AmberBrush}" Margin="0,0,8,0" />
                                                        <TextBlock Text="Night Color" Foreground="{StaticResource InkBrush}" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Tag="3" Click="OpenSettingsSectionButton_OnClick" Style="{StaticResource SoftButton}">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <TextBlock Text="&#xE787;" Style="{StaticResource IconGlyph}" FontSize="14" Foreground="{StaticResource AccentHoverBrush}" Margin="0,0,8,0" />
                                                        <TextBlock Text="Rules" Foreground="{StaticResource InkBrush}" />
                                                    </StackPanel>
                                                </Button>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Style="{StaticResource PanelCard}">
                                        <StackPanel>
                                            <TextBlock Text="Session Controls" Style="{StaticResource MetricLabel}" />
                                            <Button Click="SaveButton_OnClick" Margin="0,14,0,0">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="&#xE74E;" Style="{StaticResource IconGlyph}" FontSize="14" Foreground="{StaticResource InkBrush}" Margin="0,0,8,0" />
                                                    <TextBlock Text="Save settings" Foreground="{StaticResource InkBrush}" />
                                                </StackPanel>
                                            </Button>
                                            <Button Click="ExportDiagnosticsButton_OnClick" Margin="0,10,0,0" Style="{StaticResource SoftButton}">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="&#xE896;" Style="{StaticResource IconGlyph}" FontSize="14" Foreground="{StaticResource AccentHoverBrush}" Margin="0,0,8,0" />
                                                    <TextBlock Text="Export diagnostics" Foreground="{StaticResource InkBrush}" />
                                                </StackPanel>
                                            </Button>
                                            <Button Click="EmergencyButton_OnClick" Margin="0,10,0,0" Style="{StaticResource DangerButton}">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="&#xE7BA;" Style="{StaticResource IconGlyph}" FontSize="14" Foreground="{StaticResource DangerBrush}" Margin="0,0,8,0" />
                                                    <TextBlock Text="Emergency disable" Foreground="{StaticResource DangerBrush}" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource PanelCard}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border Style="{StaticResource SoftCard}">
                                                <StackPanel>
                                                    <TextBlock Text="Startup" Style="{StaticResource MetricLabel}" />
                                                    <TextBlock Text="Keep LumaBrake ready after Windows sign-in." Style="{StaticResource MutedText}" Margin="0,7,0,0" TextWrapping="Wrap" />
                                                    <UniformGrid Columns="2" Margin="0,14,0,0">
                                                        <Button Click="EnableStartupButton_OnClick" Margin="0,0,8,0" Style="{StaticResource SoftButton}">
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                <TextBlock Text="&#xE768;" Style="{StaticResource IconGlyph}" FontSize="13" Foreground="{StaticResource SuccessBrush}" Margin="0,0,7,0" />
                                                                <TextBlock Text="Enable" Foreground="{StaticResource InkBrush}" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Click="DisableStartupButton_OnClick" Style="{StaticResource WarningButton}">
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                <TextBlock Text="&#xE711;" Style="{StaticResource IconGlyph}" FontSize="13" Foreground="{StaticResource WarningBrush}" Margin="0,0,7,0" />
                                                                <TextBlock Text="Disable" Foreground="{StaticResource WarningBrush}" />
                                                            </StackPanel>
                                                        </Button>
                                                    </UniformGrid>
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Column="2" Style="{StaticResource SoftCard}">
                                                <StackPanel>
                                                    <TextBlock Text="Current Status" Style="{StaticResource MetricLabel}" />
                                                    <TextBlock x:Name="SettingsProtectionText" Text="Protection starting" Style="{StaticResource MetricValue}" FontSize="20" />
                                                    <TextBlock x:Name="SettingsNightColorText" Text="Night color off" Style="{StaticResource MutedText}" Margin="0,7,0,0" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Column="4" Style="{StaticResource SoftCard}">
                                                <StackPanel>
                                                    <TextBlock Text="Quick Profile" Style="{StaticResource MetricLabel}" />
                                                    <TextBlock Text="Balanced" Style="{StaticResource MetricValue}" FontSize="20" />
                                                    <TextBlock Text="Comfort cap and local protection tuned for daily browsing." Style="{StaticResource MutedText}" Margin="0,7,0,0" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>

                    <Border Grid.Row="1" Background="{StaticResource ChromeBrush}" BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,14,0">
                        <Grid Margin="18,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="LumaBrake" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{x:Static app:AppVersion.DisplayVersion}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0" />
                                <TextBlock x:Name="FooterText"
                                           Text="Service running"
                                           Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
