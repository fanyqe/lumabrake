                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="300" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="280" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="18" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Border Style="{StaticResource PanelCard}">
                                        <StackPanel>
                                            <TextBlock Text="Night Color" Style="{StaticResource MetricLabel}" />
                                            <Border Height="154" CornerRadius="8" Background="{StaticResource AmberSoftBrush}" BorderBrush="{StaticResource AmberBrush}" BorderThickness="1" Margin="0,16,0,0" Padding="16">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="76" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="62" Height="62" CornerRadius="31" Background="#26160A" BorderBrush="{StaticResource AmberBrush}" BorderThickness="1" VerticalAlignment="Top">
                                                        <TextBlock Text="&#xE708;" Style="{StaticResource IconGlyph}" FontSize="34" Foreground="{StaticResource AmberBrush}" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock x:Name="NightColorTemperatureValueText" Text="6500K" Style="{StaticResource MetricValue}" FontSize="24" Foreground="{StaticResource AmberBrush}" />
